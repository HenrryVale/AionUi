# Dependencies and build output — regenerated inside the image.
**/node_modules
out
out-fast-builds
dist
dist-server
dist-web-cli
resources/bundled-aioncore

# VCS, CI and local runtime state.
.git
.github
.husky
data
**/*.log

# Large media that is documentation-only; the renderer build reads public/,
# never resources/, and pack-web-cli.js only touches resources/bundled-aioncore.
# Patterns are anchored at the context root unless prefixed with **/.
**/*.gif
**/*.mp4
resources/*.png

# Not part of the WebUI build graph.
docs
examples
mobile
tests
# Keep one focused DOM regression in the image-build context. The parent
# directories must be re-included explicitly because Docker does not descend
# into an excluded directory when evaluating a child negation.
!tests/
tests/*
!tests/unit/
tests/unit/*
!tests/unit/renderer/
tests/unit/renderer/*
!tests/unit/renderer/messageTipsManagedSkillRouting.dom.test.tsx
homebrew
.specify
.claude
.gemini
.aionui
CHANGELOG.md
